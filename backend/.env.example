# ── REQUIRED ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── AMAZON ASSOCIATES ─────────────────────────────────────────
# Get your tag from: affiliate-program.amazon.com
# Replace in products.js too: const AMAZON_TAG = "yourtag-20"
AMAZON_PARTNER_TAG=partiqule-20

# ── AMAZON PA API (activate after 3 qualifying sales) ─────────
# Request access at: affiliate-program.amazon.com → Tools → Product Advertising API
# Takes 1-2 weeks to approve after your 3rd qualifying sale
AMAZON_ACCESS_KEY=your_pa_api_access_key
AMAZON_SECRET_KEY=your_pa_api_secret_key
AMAZON_REGION=us-east-1

# ── TO ACTIVATE PA API ────────────────────────────────────────
# 1. Make 3 qualifying sales through your Associates links
# 2. Request PA API access (link above)
# 3. Once approved, add your Access Key + Secret Key above
# 4. Restart the server — it auto-detects and switches to live Amazon results
# 5. Verify at: http://localhost:3001/health (should show "paApi: active")
